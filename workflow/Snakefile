# ---------------------------------------------------------------
# TCGA-PRAD tumor vs matched normal: DGE + pathway analysis
# ---------------------------------------------------------------
configfile: "config/config.yaml"

OUT = config["outputs"]
QC  = "results/qc"
DE  = "results/de"
GS  = "results/gsea"
VA  = "results/validation"
AN  = "results/ancestry"
DC  = "results/deconv"
SV  = "results/survival"
GEO = "data/raw/geo"   # GSE104131 files, downloaded manually (see README)

rule all:
    input:
        OUT["se_paired"],
        OUT["sample_sheet"],
        f"{QC}/qc_sample_flags.tsv",
        f"{DE}/deseq2_all_genes.tsv",
        f"{DE}/sensitivity_summary.tsv",
        f"{GS}/fgsea_hallmark.tsv",
        f"{GS}/fgsea_reactome.tsv",
        f"{VA}/validation_summary.tsv",
        f"{AN}/ancestry_summary.tsv",
        f"{DC}/deconv_summary.tsv",
        f"{SV}/survival_summary.tsv",
        "reports/report.html",
        "docs/index.html",


rule download_tcga:
    output:
        se_full    = OUT["se_full"],
        manifest   = OUT["manifest"],
        provenance = OUT["provenance"],
    log:
        "logs/01_download_tcga.log",
    conda:
        "envs/r-bioc.yaml"
    script:
        "scripts/01_download_tcga.R"


rule build_paired_set:
    input:
        se_full = OUT["se_full"],
    output:
        se_paired    = OUT["se_paired"],
        sample_sheet = OUT["sample_sheet"],
    log:
        "logs/02_build_paired_set.log",
    conda:
        "envs/r-bioc.yaml"
    script:
        "scripts/02_build_paired_set.R"


rule qc:
    input:
        se_paired = OUT["se_paired"],
    output:
        dds           = "data/processed/prad_dds_filtered.rds",
        vsd           = "data/processed/prad_vst.rds",
        flags         = f"{QC}/qc_sample_flags.tsv",
        libsize       = f"{QC}/library_sizes.png",
        pca_condition = f"{QC}/pca_condition.png",
        pca_tss       = f"{QC}/pca_tss.png",
        pca_plate     = f"{QC}/pca_plate.png",
        heatmap       = f"{QC}/sample_distance_heatmap.png",
        markers       = f"{QC}/purity_marker_score.png",
    params:
        min_count   = 10,    # min reads for a gene to count as expressed in a sample
        n_top_genes = 500,   # most variable genes used for PCA
    log:
        "logs/03_qc.log",
    conda:
        "envs/r-bioc.yaml"
    script:
        "scripts/03_qc.R"


rule deseq2:
    input:
        dds       = "data/processed/prad_dds_filtered.rds",
        flags     = f"{QC}/qc_sample_flags.tsv",
        se_paired = OUT["se_paired"],
    output:
        dds_fit      = "data/processed/prad_dds_fitted.rds",
        table_all    = f"{DE}/deseq2_all_genes.tsv",
        table_sig    = f"{DE}/deseq2_significant.tsv",
        volcano      = f"{DE}/volcano.png",
        ma           = f"{DE}/ma_plot.png",
        heatmap      = f"{DE}/top50_heatmap.png",
        sens_plot    = f"{DE}/sensitivity_concordance.png",
        sens_summary = f"{DE}/sensitivity_summary.tsv",
        purity       = f"{DE}/purity_check.tsv",
    params:
        fdr = 0.05,   # adjusted p-value cutoff
        lfc = 1,      # |log2FC| cutoff (2-fold) for the DEG list
    threads: 4
    log:
        "logs/04_deseq2.log",
    conda:
        "envs/r-bioc.yaml"
    script:
        "scripts/04_deseq2.R"


rule gsea:
    input:
        de = f"{DE}/deseq2_all_genes.tsv",
    output:
        ranks          = f"{GS}/ranked_genes.rnk",
        hallmark       = f"{GS}/fgsea_hallmark.tsv",
        reactome       = f"{GS}/fgsea_reactome.tsv",
        ora            = f"{GS}/ora_hallmark.tsv",
        concordance    = f"{GS}/hallmark_gsea_vs_ora.tsv",
        hallmark_plot  = f"{GS}/hallmark_nes.png",
        reactome_plot  = f"{GS}/reactome_top_dotplot.png",
        enrichment_pdf = f"{GS}/hallmark_enrichment_plots.pdf",
    params:
        fdr      = 0.05,
        min_size = 15,    # smallest gene set tested
        max_size = 500,   # largest gene set tested
        seed     = 42,
    threads: 4
    log:
        "logs/05_gsea.log",
    conda:
        "envs/r-bioc.yaml"
    script:
        "scripts/05_gsea.R"


rule geo_validation:
    input:
        counts        = f"{GEO}/GSE104131_raw_counts_GRCh38.p13_NCBI.tsv.gz",
        matrix        = f"{GEO}/GSE104131_series_matrix.txt.gz",
        tcga_de       = f"{DE}/deseq2_all_genes.tsv",
        tcga_hallmark = f"{GS}/fgsea_hallmark.tsv",
    output:
        sample_sheet = "data/processed/geo_sample_sheet.tsv",
        dds_fit      = "data/processed/geo_dds_fitted.rds",
        de           = f"{VA}/geo_deseq2_all_genes.tsv",
        hallmark     = f"{VA}/geo_fgsea_hallmark.tsv",
        summary      = f"{VA}/validation_summary.tsv",
        lfc_plot     = f"{VA}/lfc_concordance.png",
        score_plot   = f"{VA}/tcga_signature_score.png",
        nes_plot     = f"{VA}/hallmark_nes_concordance.png",
    params:
        fdr       = 0.05,
        lfc       = 1,
        min_count = 10,
        sig_size  = 100,   # top N up and N down TCGA DEGs used for the signature score
        seed      = 42,
    threads: 4
    log:
        "logs/06_geo_validation.log",
    conda:
        "envs/r-bioc.yaml"
    script:
        "scripts/06_geo_validation.R"


rule ancestry:
    input:
        geo_dds = "data/processed/geo_dds_fitted.rds",
        se_full = OUT["se_full"],
        tcga_de = f"{DE}/deseq2_all_genes.tsv",
    output:
        geo_table          = f"{AN}/geo_ancestry_tumor_effects.tsv",
        geo_scatter        = f"{AN}/geo_ancestry_lfc_scatter.png",
        geo_hallmark       = f"{AN}/geo_ancestry_hallmark_pairlevel.tsv",
        geo_hallmark_plot  = f"{AN}/geo_ancestry_hallmark_pairlevel.png",
        geo_pair_qc        = f"{AN}/geo_pair_qc.tsv",
        tcga_sheet         = f"{AN}/tcga_race_sample_sheet.tsv",
        tcga_table         = f"{AN}/tcga_race_deseq2.tsv",
        tcga_mt            = f"{AN}/tcga_race_mt_pseudogene_hits.tsv",
        tcga_volcano       = f"{AN}/tcga_race_volcano.png",
        tcga_hallmark      = f"{AN}/tcga_race_hallmark.tsv",
        tcga_hallmark_plot = f"{AN}/tcga_race_hallmark.png",
        tcga_site_hallmark = f"{AN}/tcga_race_site_matched_hallmark.tsv",
        tcga_site_plot     = f"{AN}/tcga_race_site_matched_nes.png",
        summary            = f"{AN}/ancestry_summary.tsv",
    params:
        fdr          = 0.05,
        lfc          = 1,
        min_count    = 10,
        min_per_site = 3,   # sites need >= this many Black AND White patients for the site-matched check
        seed         = 42,
    threads: 4
    log:
        "logs/07_ancestry.log",
    conda:
        "envs/r-bioc.yaml"
    script:
        "scripts/07_ancestry.R"


rule deconvolution:
    input:
        se_full       = OUT["se_full"],
        se_paired     = OUT["se_paired"],
        dds           = "data/processed/prad_dds_filtered.rds",
        hallmark      = f"{GS}/fgsea_hallmark.tsv",
        race_sheet    = f"{AN}/tcga_race_sample_sheet.tsv",
        race_hallmark = f"{AN}/tcga_race_hallmark.tsv",
    output:
        scores            = f"{DC}/cell_scores.tsv",
        paired_tests      = f"{DC}/paired_composition_tests.tsv",
        paired_plot       = f"{DC}/paired_composition.png",
        adj_hallmark      = f"{DC}/adjusted_paired_hallmark.tsv",
        adj_plot          = f"{DC}/adjusted_paired_hallmark.png",
        race_comp         = f"{DC}/race_composition.tsv",
        race_plot         = f"{DC}/race_composition.png",
        race_adj_hallmark = f"{DC}/race_adjusted_hallmark.tsv",
        summary           = f"{DC}/deconv_summary.tsv",
    params:
        fdr       = 0.05,
        min_count = 10,
        seed      = 42,
    threads: 4
    log:
        "logs/08_deconvolution.log",
    conda:
        "envs/r-bioc.yaml"
    script:
        "scripts/08_deconvolution.R"

rule download_cdr:
    # TCGA Pan-Cancer Clinical Data Resource (Liu et al. 2018, Cell), via the GDC API
    output:
        "data/raw/clinical/TCGA-CDR-SupplementalTableS1.xlsx",
    log:
        "logs/download_cdr.log",
    shell:
        "mkdir -p data/raw/clinical && "
        "curl -fL -o {output} https://api.gdc.cancer.gov/data/1b5f413e-a8d1-4d10-92eb-7c4ae739ed81 > {log} 2>&1"


rule survival:
    input:
        se_full = OUT["se_full"],
        cdr     = "data/raw/clinical/TCGA-CDR-SupplementalTableS1.xlsx",
        de      = f"{DE}/deseq2_all_genes.tsv",
        scores  = f"{DC}/cell_scores.tsv",
    output:
        dataset = f"{SV}/survival_dataset.tsv",
        cox     = f"{SV}/cox_results.tsv",
        km      = f"{SV}/km_plots.png",
        forest  = f"{SV}/forest_plot.png",
        summary = f"{SV}/survival_summary.tsv",
    params:
        fdr      = 0.05,
        sig_size = 100,   # top N up and N down DEGs in the tumor signature
    log:
        "logs/09_survival.log",
    conda:
        "envs/r-bioc.yaml"
    script:
        "scripts/09_survival.R"

rule report:
    input:
        qmd = "reports/report.qmd",
        results = [
            OUT["provenance"], OUT["sample_sheet"],
            f"{QC}/qc_sample_flags.tsv", f"{QC}/pca_condition.png", f"{QC}/purity_marker_score.png",
            f"{DE}/deseq2_all_genes.tsv", f"{DE}/sensitivity_summary.tsv", f"{DE}/purity_check.tsv",
            f"{GS}/fgsea_hallmark.tsv", f"{GS}/hallmark_gsea_vs_ora.tsv",
            f"{VA}/validation_summary.tsv",
            f"{AN}/ancestry_summary.tsv", f"{AN}/tcga_race_site_matched_hallmark.tsv",
        ],
    output:
        html  = "reports/report.html",
        pages = "docs/index.html",   # copy for GitHub Pages (serve from /docs)
    log:
        "logs/08_report.log",
    conda:
        "envs/r-bioc.yaml"
    shell:
        "quarto render {input.qmd} --to html > {log} 2>&1 && "
        "mkdir -p docs && cp {output.html} {output.pages}"